---
import { orvasContent } from "@/content/orvas-content";
const { brand, header } = orvasContent;
---

<a class="skip-link" href="#main">{header.skipLink}</a>
<header class="site-header" data-header>
  <a href="/" class="logo" aria-label={`${brand.name}, home`}>{brand.name}</a>
  <p class="discipline">{header.discipline[0]}<br />{header.discipline[1]}</p>
  <div class="squares" aria-hidden="true"><span></span><span></span></div>
  <nav class="nav" aria-label="Primary">
    {
      header.nav.map((item) => (
        <a href={item.href} data-nav-link>
          <span class="roll">
            <span>{item.label}</span>
            <span aria-hidden="true">{item.label}</span>
          </span>
        </a>
      ))
    }
  </nav>
  <p class="meta">{header.meta[0]}<br />{header.meta[1]}</p>

  <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-button>
    <span class="visually-hidden">{header.menuLabel}</span>
    <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
  </button>
  <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile" data-menu hidden>
    {header.nav.map((item) => <a href={item.href} data-nav-link>{item.label}</a>)}
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    display: grid;
    grid-template-columns: 22.7% 27.3% 15% 1fr auto;
    align-items: start;
    padding: var(--header-top) var(--gutter) 0;
    height: var(--header-h);
    pointer-events: none;
    font-size: var(--fs-micro);
    line-height: 14px;
  }
  .site-header > * {
    pointer-events: auto;
  }
  .logo {
    font-size: var(--fs-logo);
    line-height: 12px;
    padding-top: 1px;
    letter-spacing: 0.035em;
  }
  .discipline,
  .meta {
    color: var(--ink);
  }
  .meta {
    text-align: right;
  }
  .squares {
    display: flex;
    gap: 7px;
    transform: translateX(-50%);
    padding-top: 1px;
  }
  .squares span {
    width: 9px;
    height: 9px;
    border: 1px solid currentColor;
  }
  .squares span + span {
    background: currentColor;
  }
  .nav {
    display: flex;
    gap: 28px;
  }
  .nav a {
    display: block;
    line-height: 14px;
  }
  .nav a[aria-current="true"] {
    color: var(--accent);
  }

  .menu-button,
  .mobile-menu {
    display: none;
  }

  @media (max-width: 1024px) {
    .site-header {
      grid-template-columns: 1fr auto 1fr;
    }
    .discipline,
    .meta {
      display: none;
    }
    .nav {
      gap: 20px;
      justify-self: end;
    }
    .squares {
      transform: none;
      justify-self: center;
    }
  }

  @media (max-width: 767px) {
    .site-header {
      padding-top: 20px;
    }
    .nav {
      display: none;
    }
    .menu-button {
      display: grid;
      justify-self: end;
      align-content: center;
      gap: 5px;
      width: 44px;
      height: 44px;
      margin: -15px -12px 0 0;
      padding: 12px;
    }
    .menu-button span:not(.visually-hidden) {
      display: block;
      width: 20px;
      height: 1px;
      background: currentColor;
      transition: transform var(--dur-fade) ease, opacity var(--dur-fade) ease;
    }
    .menu-button[aria-expanded="true"] span:nth-child(2) {
      transform: translateY(6px) rotate(45deg);
    }
    .menu-button[aria-expanded="true"] span:nth-child(3) {
      opacity: 0;
    }
    .menu-button[aria-expanded="true"] span:nth-child(4) {
      transform: translateY(-6px) rotate(-45deg);
    }
    .mobile-menu {
      position: absolute;
      top: 64px;
      right: var(--gutter);
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 0;
      opacity: 0;
      transform: translateY(-6px);
      transition: opacity var(--dur-fade) ease, transform var(--dur-fade) ease;
    }
    .mobile-menu[hidden] {
      display: none;
    }
    .mobile-menu.is-open {
      opacity: 1;
      transform: none;
    }
    .mobile-menu a {
      padding: 15px 0;
      font-size: 10px;
      text-shadow: 0 0 12px rgb(0 0 0 / 0.6);
    }
  }
</style>
