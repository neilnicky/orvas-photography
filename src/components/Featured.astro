---
import Img from "./Img.astro";
import SectionLine from "./SectionLine.astro";
import { orvasContent } from "@/content/orvas-content";
import { categoryLabel, getSeries, pad2, seriesHref } from "@/lib/content";
const { featured } = orvasContent;
const items = featured.items.map((item) => ({ ...item, s: getSeries(item.series) }));
const last = pad2(items.length);
---

<section class="featured" data-featured aria-labelledby="featured-title">
  <div class="featured-stage">
    <SectionLine a={featured.label[0]} b={featured.label[1]} managed id="featured-title" />
    <div class="row4 featured-row">
      <p class="dim">{featured.intro}</p>
      <p>{featured.taxonomy}</p>
      <p>{featured.statement}</p>
      <dl class="meta-pairs">
        {
          featured.meta.map(([k, v]) => (
            <>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </>
          ))
        }
      </dl>
    </div>

    <div class="featured-body">
      <div class="featured-texts" aria-live="polite">
        {
          items.map((item, i) => (
            <article class="featured-text" data-featured-text hidden={i !== 0}>
              <h3 class="featured-title">
                <span class="sq" aria-hidden="true" /> {pad2(i + 1)} — {item.s.title}
              </h3>
              <dl class="featured-meta">
                <dt>Category</dt>
                <dd>{categoryLabel(item.s.category)}</dd>
                <dt>Year</dt>
                <dd>{item.s.year}</dd>
                <dt>Frames</dt>
                <dd>{pad2(item.s.images.length)}</dd>
              </dl>
              <a class="ulink" href={seriesHref(item.s.slug)}>
                {featured.viewLabel}
                <span class="sq" aria-hidden="true" />
              </a>
            </article>
          ))
        }
      </div>

      <div class="featured-frames" data-featured-frames>
        {
          items.map((item, i) => (
            <a class="featured-card" href={seriesHref(item.s.slug)} data-featured-card tabindex="-1" aria-hidden={i !== 0 ? "true" : undefined}>
              {item.images.map((image) => (
                <span class="featured-img" data-wave>
                  <Img image={image} sizes="(max-width: 767px) 50vw, 32vw" widths={[480, 720, 1000]} />
                </span>
              ))}
            </a>
          ))
        }
      </div>

      <div class="featured-progress" aria-hidden="true">
        <span>01</span>
        <span class="featured-rail"><span class="featured-dot" data-featured-dot></span></span>
        <span>{last}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .featured {
    position: relative;
    background: var(--bg);
  }
  :global(.js:not(.reduced)) .featured {
    height: 200vh;
  }
  .featured-stage {
    display: flex;
    flex-direction: column;
    padding-top: var(--section-pad-top);
    padding-bottom: var(--gutter);
  }
  :global(.js:not(.reduced)) .featured-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
  }
  .featured-row {
    margin-top: 6px;
  }
  .featured-body {
    position: relative;
    flex: 1;
    display: grid;
    grid-template-columns: 34.7% 1fr;
    grid-template-rows: 1fr auto;
    margin-top: 56px;
    padding-inline: var(--gutter);
    min-height: 0;
  }
  .featured-texts {
    grid-row: 1;
    display: grid;
    align-content: start;
  }
  .featured-text {
    display: grid;
    gap: 22px;
    max-width: 260px;
  }
  .featured-text[hidden] {
    display: none;
  }
  .featured-title {
    display: flex;
    gap: 8px;
    align-items: baseline;
  }
  .featured-meta {
    display: grid;
    grid-template-columns: 90px 1fr;
    row-gap: 2px;
  }
  .featured-meta dt {
    color: var(--ink-dim);
  }

  .featured-frames {
    grid-row: 1 / 3;
    grid-column: 2;
    position: relative;
    min-height: 0;
  }
  .featured-card {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    clip-path: inset(0 0 var(--clip, 0%) 0);
  }
  .featured-card:not(:first-child) {
    --clip: 100%;
  }
  .featured-img {
    position: relative;
    overflow: hidden;
  }
  .featured-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .featured-progress {
    grid-row: 2;
    grid-column: 1;
    align-self: end;
    display: flex;
    align-items: center;
    gap: 10px;
    width: 240px;
    font-size: var(--fs-label);
  }
  .featured-rail {
    position: relative;
    flex: 1;
    height: 1px;
    background: var(--ink-faint);
  }
  .featured-dot {
    position: absolute;
    top: -2px;
    left: calc(var(--at, 0) * (100% - 5px));
    width: 5px;
    height: 5px;
    background: var(--accent);
    transition: left 0.6s var(--ease-ui);
  }

  @media (max-width: 767px) {
    :global(.js:not(.reduced)) .featured {
      height: auto;
    }
    :global(.js:not(.reduced)) .featured-stage {
      position: relative;
      height: auto;
      padding-bottom: 48px;
    }
    .featured-frames {
      aspect-ratio: 3 / 2;
    }
    .featured-body {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr auto;
      gap: 20px;
      margin-top: 32px;
    }
    .featured-frames {
      grid-row: 2;
      grid-column: 1;
    }
    .featured-progress {
      grid-row: 3;
    }
  }
</style>
