---
import Base from "@/layouts/Base.astro";
import Img from "@/components/Img.astro";
import SectionLine from "@/components/SectionLine.astro";
import { orvasContent, series } from "@/content/orvas-content";
import { archiveOrder, categoryLabel, coverOf, pad2, seriesByCategory, seriesHref } from "@/lib/content";
import type { Category } from "@/content/orvas-content";

const { workPage, brand, seo } = orvasContent;
const groups: Category[] = ["fashion", "boudoir"];
---

<Base title={`${workPage.title} — ${brand.name}`} description={seo.description}>
  <section class="archive" aria-labelledby="archive-title">
    <SectionLine a={workPage.title} b={`${series.length} series`} id="archive-title" as="h1" />
    <div class="row4 archive-row">
      <p>{workPage.intro}</p>
      <p>{groups.map(categoryLabel).join(" / ")}</p>
      <span aria-hidden="true"></span>
      <dl class="meta-pairs">
        {
          groups.map((g) => (
            <>
              <dt>{categoryLabel(g)}</dt>
              <dd>{seriesByCategory(g).length}</dd>
            </>
          ))
        }
      </dl>
    </div>

    {
      groups.map((g) => (
        <section class="archive-group" id={g} aria-labelledby={`group-${g}`}>
          <h2 class="archive-group-title" id={`group-${g}`}>
            <span class="sq" aria-hidden="true" /> {categoryLabel(g)}
          </h2>
          <ol class="archive-grid">
            {archiveOrder(seriesByCategory(g)).map((s, i) => (
              <li>
                <a href={seriesHref(s.slug)} class="archive-card">
                  <span class="archive-media" data-series-frame>
                    <Img image={coverOf(s)} sizes="(max-width: 767px) 50vw, (max-width: 1024px) 33vw, 20vw" widths={[400, 640, 900]} />
                  </span>
                  <span class="archive-meta">
                    <span class="dim">{pad2(i + 1)}</span>
                    <span class="roll">
                      <span>{s.title}</span>
                      <span aria-hidden="true">{s.title}</span>
                    </span>
                    <span class="dim">{s.year}</span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </section>
</Base>

<style>
  .archive {
    padding-top: var(--section-pad-top);
    padding-bottom: 80px;
  }
  .archive-row {
    margin-top: 6px;
    margin-bottom: 64px;
  }
  .archive-group {
    padding-inline: var(--gutter);
    margin-bottom: 72px;
    scroll-margin-top: 72px;
  }
  .archive-group-title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
  }
  .archive-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 28px 8px;
  }
  .archive-card {
    display: grid;
    gap: 10px;
  }
  .archive-media {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--bg-deep);
  }
  .archive-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease-ui);
  }
  @media (hover: hover) {
    .archive-card:hover .archive-media :global(img) {
      transform: scale(1.03);
    }
  }
  .archive-meta {
    display: grid;
    grid-template-columns: 28px 1fr auto;
    gap: 6px;
    align-items: start;
  }
  .archive-meta .roll {
    white-space: normal;
  }
  .archive-meta .roll > span + span {
    display: none;
  }
  @media (hover: hover) {
    .archive-card:hover .archive-meta {
      color: var(--accent);
    }
  }
  @media (max-width: 1024px) {
    .archive-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 767px) {
    .archive-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
