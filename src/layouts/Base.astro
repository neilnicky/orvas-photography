---
import { getImage } from "astro:assets";
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Loader from "@/components/Loader.astro";
import { orvasContent } from "@/content/orvas-content";
import { resolveImage } from "@/lib/images";
import type { ImageRef } from "@/content/orvas-content";

interface Props {
  title?: string;
  description?: string;
  image?: ImageRef;
  /** Home page shows the loader on first visit. */
  loader?: boolean;
}

const { seo } = orvasContent;
const { title = seo.title, description = seo.description, image = seo.ogImage, loader = false } = Astro.props;
const og = await getImage({ src: resolveImage(image.src), width: 1200, format: "jpg", quality: 80 });
const origin = seo.siteUrl ?? Astro.url.origin;
const canonical = seo.siteUrl ? new URL(Astro.url.pathname, seo.siteUrl).href : undefined;
const ogUrl = new URL(og.src, origin).href;
---

<!doctype html>
<html lang={seo.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0b0b0b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline define:vars={{ loader }}>
      (function () {
        var d = document.documentElement;
        d.classList.add("js");
        var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reduced) d.classList.add("reduced");
        var seen = false;
        try {
          seen = sessionStorage.getItem("orvas-loaded") === "1";
        } catch (e) {}
        if (loader && !reduced && !seen) d.classList.add("is-loading");
      })();
    </script>
  </head>
  <body>
    {loader && <Loader />}
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import "@/motion/main";
    </script>
  </body>
</html>
